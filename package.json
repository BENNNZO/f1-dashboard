{
    "name": "f1-dashboard",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.5.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build && tsc -p tsconfig.server.json",
        "start": "next start",
        "start:server": "node dist/server/index.js",
        "lint": "biome check",
        "format": "biome check --write --unsafe",
        "server": "tsx --tsconfig tsconfig.server.json server/index.ts",
        "record": "tsx --tsconfig tsconfig.server.json server/simulate/record.ts",
        "replay": "tsx --tsconfig tsconfig.server.json server/simulate/replay.ts"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.2",
        "axios": "^1.8.3",
        "lucide-react": "^1.61.0",
        "motion": "^13.5.1",
        "next": "16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "three": "^0.186.1",
        "ws": "^8.18.1",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.16",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.186.0",
        "@types/ws": "^8.18.0",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5"
    }
}
